  },
  "strategies": [
    {
      "id": "B",
      "version": "1.0",
      "status": "UNVALIDATED",
      "parameters": {
        "breakout_atr_buffer": "0.05",
        "rvol_min": "1.5",
        "vwap_distance_atr_max": "1.5",
        "stop_atr_buffer": "0.1",
        "stop_distance_atr_min": "0.8",
        "stop_distance_atr_max": "2"
      },
      "predicates": [
        "C[t-1] <= ORH",
        "C[t] > ORH + breakout_atr_buffer*ATR[t]",
        "RVOL[t] >= rvol_min",
        "0 < C[t]-VWAP[t] <= vwap_distance_atr_max*ATR[t]"
      ],
      "stop_formula": "S_raw=min(L[t],L[t-1])-stop_atr_buffer*ATR[t]",
      "post_rounding_predicate": "stop_distance_atr_min*ATR[t] <= P-S <= stop_distance_atr_max*ATR[t]"
    },
    {
      "id": "P",
      "version": "1.0",
      "status": "UNVALIDATED",
      "parameters": {
        "ema_slope_offset_bars": 3,
        "pullback_offsets": [
          1,
          2,
          3
        ],
        "pullback_low_atr_max": "0.25",
        "pullback_close_atr_min": "-0.5",
        "rvol_min": "1.2",
        "ema_distance_atr_max": "1",
        "stop_low_offsets": [
          0,
          1,
          2,
          3
        ],
        "stop_atr_buffer": "0.1",
        "stop_distance_atr_min": "0.8",
        "stop_distance_atr_max": "2"
      },
      "predicates": [
        "EMA[t] > EMA[t-3]",
        "exists k in {t-1,t-2,t-3}: L[k] <= EMA[k]+pullback_low_atr_max*ATR[k] AND C[k] >= EMA[k]+pullback_close_atr_min*ATR[k]",
        "C[t] > H[t-1]",
        "C[t] > EMA[t]",
        "C[t] > VWAP[t]",
        "RVOL[t] >= rvol_min",
        "C[t]-EMA[t] <= ema_distance_atr_max*ATR[t]"
      ],
      "stop_formula": "S_raw=min(L[t],L[t-1],L[t-2],L[t-3])-stop_atr_buffer*ATR[t]",
      "post_rounding_predicate": "stop_distance_atr_min*ATR[t] <= P-S <= stop_distance_atr_max*ATR[t]"
    }
  ],
  "boundary_contract": {
    "strict_and_inclusive_operators_preserved": true,

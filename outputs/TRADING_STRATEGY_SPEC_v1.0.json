    "atr": {
      "period": 14,
      "method": "WILDER",
      "seed": "MEAN_FIRST_14_TR",
      "include_session_gap": true,
      "formula": "TR=max(H-L,abs(H-C_prev),abs(L-C_prev)); ATR=(13*ATR_prev+TR)/14"
    },
    "ema": {
      "period": 20,
      "alpha_numerator": 2,
      "alpha_denominator": 21,
      "seed": "MEAN_FIRST_20_CLOSES"
    },
    "vwap": {
      "reset": "SESSION_OPEN",
      "formula": "sum(((H+L+C)/3)*V)/sum(V)",
      "source": "COMPLETED_1_MINUTE_BARS",
      "zero_denominator": "ABSTAIN"
    },
    "relative_volume": {
      "reference_sessions": 20,
      "reference": "SAME_BAR_POSITION_PRIOR_COMPARABLE_SESSIONS_MEDIAN",
      "exclude_current_session": true,
      "zero_denominator": "ABSTAIN"
    },
    "opening_range": {
      "minutes": 30,
      "freeze_after_completion": true
    },
    "volatility_ceiling": {
      "lookback_sessions": 60,
      "feature": "ATR14/C",
      "reference": "SAME_BAR_POSITION_PRIOR_VALID_SESSIONS",
      "percentile": "0.95",
      "method": "NEAREST_RANK_CEIL",
      "reject": "CURRENT_STRICTLY_GREATER"
    }
  },
  "common_predicates": [
    "instrument.previous_daily_close > instrument.SMA60",
    "instrument.SMA20 > instrument.SMA60",
    "benchmark.previous_daily_close > benchmark.SMA60",
    "benchmark.C[t] > benchmark.VWAP_approx[t]"
